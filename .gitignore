# =========================================
# Aura-Shield Master .gitignore
# =========================================

# 1. Node Modules (Never push dependencies, team will use 'npm install')
node_modules/
frontend/node_modules/
backend/node_modules/

# 2. Environment Variables & Secrets (CRITICAL: Never push DB links!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# 3. Production Build Files (Vite generates this automatically later)
dist/
dist-ssr/
build/
frontend/dist/

# 4. Error Logs (npm errors)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# 5. OS & Editor generated files (System clutter)
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln